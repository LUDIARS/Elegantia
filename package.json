{
  "name": "@ludiars/elegantia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-backed quality criteria and test result tracking",
  "engines": {
    "node": "24.17.x"
  },
  "scripts": {
    "build:shared": "node node_modules/typescript/bin/tsc -p node_modules/@ludiars/vestigium/tsconfig.json --typeRoots node_modules/@types",
    "prebuild": "npm run build:shared && npm run catalog:docs",
    "pretypecheck": "node scripts/prepare-typecheck.mjs",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "start": "node dist/src/server.js",
    "catalog:docs": "node scripts/render-catalog.mjs",
    "audit:fix": "npm audit fix --ignore-scripts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.12.0",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.16.0",
    "ws": "^8.18.0",
    "zod": "^4.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "@ludiars/vestigium": "https://codeload.github.com/LUDIARS/Vestigium/tar.gz/ce1b5880ca9914cf5b7667ce7ced7c0328622177",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "tailwindcss": "^4.2.0",
    "@tailwindcss/vite": "^4.2.0"
  }
}
