# Inject credentials through the existing secret manager; never commit .env.
# Optional. Default: .local/elegantia.sqlite relative to the project root.
# ELEGANTIA_DATABASE_PATH=.local/elegantia.sqlite
# Optional pair. When both are set, requests that carry a Cloudflare Access token
# (Cf-Access-Jwt-Assertion) issued by this team for this application may READ
# evaluations and human reviews from the public URL. Writes stay loopback-only.
# ELEGANTIA_CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# ELEGANTIA_CF_ACCESS_AUD=<application audience tag>
